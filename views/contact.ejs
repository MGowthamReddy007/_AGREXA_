<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a> / Contact</p>
    <h1>Talk to a real agronomist</h1>
    <p class="lead">Every farmer contact reaches the AGREXA team directly — not a ticket queue.</p>
  </div>
</section>

<section class="section" style="padding-top:44px">
  <div class="wrap split" style="align-items:start">
    <div>
      <h2 style="margin-bottom:20px">Send your enquiry</h2>
      <form class="form" id="contact-form">
        <div class="row">
          <div class="field"><label for="name">Name *</label><input id="name" name="name" required placeholder="Gowtham Reddy"></div>
          <div class="field"><label for="phone">Phone *</label><input id="phone" name="phone" type="tel" required placeholder="9014791483"></div>
        </div>
        <div class="row">
          <div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" required placeholder="you@example.com"></div>
          <div class="field"><label for="subject">Subject</label>
            <select id="subject" name="subject">
              <option>Product enquiry</option><option>Pest problem — need advice</option>
              <option>Dealership interest</option><option>Bulk order</option><option>Other</option>
            </select>
          </div>
        </div>
        <div class="field"><label for="message">Message *</label><textarea id="message" name="message" rows="5" required placeholder="Crop, place, and what you need — in your own words."></textarea></div>
        <button class="btn btn-green" type="submit" id="contact-btn" style="justify-content:center"><span data-i18n="contact.save">Send Message</span></button>
        <p class="form-note">Your details are stored securely and used only to reply — never sold or spammed.</p>
      </form>
    </div>
    <div>
      <div class="card" style="margin-bottom:18px">
        <h3>☎ Direct contact</h3>
        <ul class="check-list" style="margin-top:12px">
          <li><a href="tel:+919014791483"><b>90147 91483</b> — Phone &amp; WhatsApp</a></li>
          <li><a href="mailto:mgowthamreddy2008@gmail.com">mgowthamreddy2008@gmail.com</a></li>
          <li>Contact person: <b>Gowtham Reddy</b></li>
          <li>Reply promise: within 24 hours</li>
        </ul>
        <a class="btn btn-sm wam-btn" style="background:#25D366;color:#fff;margin-top:14px" href="https://wa.me/919014791483" target="_blank" rel="noopener">WhatsApp us directly</a>
      </div>
      <div class="card" style="margin-bottom:18px">
        <h3>📍 Visit the office</h3>
        <p style="margin-top:10px">Krishna Reddy Bunglow, Vedanagar,<br>H.No 6-1-80, Jogulamba Gadwal,<br>Jogulamba Gadwal District, Telangana, India</p>
        <div class="booking-note" style="margin-top:12px">Nearby areas we serve: Ieeja · Alampur · Kallur · Waddepalle · Mantralayam side of the border · Wanaparthy · Kurnool belt</div>
      </div>
      <div class="map-frame">
        <iframe title="AGREXA office location — Jogulamba Gadwal, Telangana" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=Gadwal,+Jogulamba+Gadwal,+Telangana+509001&output=embed"></iframe>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script>
document.getElementById('contact-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('contact-btn');
  const fd = new FormData(e.target);
  btn.disabled = true;
  btn.querySelector('span').textContent = AGREXA.lang() === 'te' ? 'పంపుతున్నాం…' : AGREXA.lang() === 'hi' ? 'भेज रहे हैं…' : 'Sending…';
  try {
    const j = await AGREXA.postJSON('/api/contact', {
      name: fd.get('name'), email: fd.get('email'), phone: fd.get('phone'),
      subject: fd.get('subject'), message: fd.get('message'),
    });
    AGREXA.toast(j.message || 'Thank you! Our team will contact you within 24 hours.');
    e.target.reset();
  } catch (err) {
    AGREXA.toast(err.message, false);
  } finally {
    btn.disabled = false;
    btn.querySelector('span').textContent = AGREXA.lang() === 'te' ? 'సందేశం పంపండి' : AGREXA.lang() === 'hi' ? 'संदेश भेजें' : 'Send Message';
  }
});
</script>
