<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a> / Dealer</p>
    <h1>Become an AGREXA dealer</h1>
    <p class="lead">Retail counters across Telangana &amp; AP — apply below and our team calls you within 2 working days.</p>
  </div>
</section>

<section class="section" style="padding-top:44px">
  <div class="wrap split" style="align-items:start">
    <form class="form" id="dealer-form">
      <div class="row">
        <div class="field"><label>Shop / your name *</label><input name="name" required></div>
        <div class="field"><label>Place (village/town) *</label><input name="place" required placeholder="e.g. Ieeja"></div>
      </div>
      <div class="row">
        <div class="field"><label>Phone *</label><input name="phone" type="tel" required></div>
        <div class="field"><label>Existing pesticide licence?</label>
          <select name="licence"><option>Yes — issued licence</option><option>No — will apply</option></select>
        </div>
      </div>
      <div class="field"><label>Anything we should know?</label><textarea name="message" rows="4" placeholder="Monthly agri-turnover, crops in your area…"></textarea></div>
      <button class="btn btn-green" type="submit" style="justify-content:center">Submit Enquiry</button>
    </form>
    <div class="grid" style="gap:14px">
      <div class="card"><h3>Why dealers stay</h3><p>Consistent peak-season stock · honest margins with no forced bundles · free safe-storage training · advisory backup in Telugu/Hindi/English.</p></div>
      <div class="card"><h3>What we look for</h3><p>A licensed counter, storage that meets safe-keeping practice, and willingness to advise farmers honestly — dosages and PHIs included.</p></div>
      <div class="callout"><h3>Questions first?</h3><p>Call <a href="tel:+919014791483"><b>90147 91483</b></a> and ask for the dealer desk.</p></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script>
document.getElementById('dealer-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button');
  btn.disabled = true;
  try {
    const fd = new FormData(e.target);
    const j = await AGREXA.postJSON('/api/dealers', {
      name: fd.get('name'), place: fd.get('place'), phone: fd.get('phone'), message: fd.get('message'),
    });
    AGREXA.toast(j.message);
    e.target.reset();
  } catch (err) { AGREXA.toast(err.message, false); }
  finally { btn.disabled = false; }
});
</script>
