        <tr><td>Rice 🌾</td><td>Stem borer dead hearts; keep 5 cm water + Cartap GR if &gt;2 egg masses/m²</td></tr>
        <tr><td>Cotton 🧴</td><td>Sucking pests on leaf undersides — neem weekly, Imidacloprid if &gt;50% leaves curl</td></tr>
        <tr><td>Chilli 🌶</td><td>Thrips leaf-curl start — act on first curled leaves, not after murda</td></tr>
        <tr><td>Groundnut 🥜</td><td>Tikka leaf spot scout after 40 DAS; seal spray before rust pustules spread</td></tr>
        <tr><td>Maize/Jowar 🌽</td><td>Fall armyworm windowing — whorl-directed Emamectin at &gt;20% plants</td></tr>
      </table>
