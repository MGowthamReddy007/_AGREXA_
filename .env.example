# AGREXA environment variables — copy this file to .env and fill in.
PORT=3000

# ---- Supabase (free tier: https://supabase.com) ----
# Leave empty to fall back to local JSON storage (data/*.json).
SUPABASE_URL=
# Use the service_role key ONLY server-side (never expose in browser).
SUPABASE_SERVICE_KEY=

# ---- AI Pest Finder ----
# The site works with ZERO keys: a built-in rule-based agronomy engine answers,
# and every recommendation is saved for analytics.
#
# Optional: add any ONE of these (all free/cheapest tiers friendly) and the
# AI Pest Finder will use real LLM reasoning. Providers are tried in this order.
GROQ_API_KEY=          # free at console.groq.com  (llama-3.3-70b)
GEMINI_API_KEY=        # free at aistudio.google.com (gemini-2.0-flash)
DEEPSEEK_API_KEY=      # deepseek-chat (paid, cheap)
OPENAI_API_KEY=        # gpt-4o
ANTHROPIC_API_KEY=     # claude-sonnet-4
# Optional: custom OpenAI-compatible endpoint
OPENROUTER_API_KEY=    # free models available at openrouter.ai

# ---- Email service (optional — leads always save to DB + console) ----
# Gmail: enable 2FA, create an App Password, use smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEAD_MAIL_TO=mgowthamreddy2008@gmail.com

# ---- WhatsApp Business API (ready for future integration) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
